@model EcoCityWaste.Models.RegisterViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EcoCityWaste - Registar</title>

    <link rel="stylesheet" href="~/css/login.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>

<body>

    <div class="main-container">

        <div class="left-panel">
            <div class="logo-container">
                <img src="~/img/logo.png"
                     alt="EcoCityWaste Logótipo"
                     class="logo"
                     style="transform: translateX(50px);">
            </div>
        </div>


        <div class="right-panel">
            <div class="auth-box">


                <!-- Header igual ao Login -->
                <div class="auth-header">

                    <h1 class="inactive">
                        <a asp-controller="Account" asp-action="Login">Login</a>
                    </h1>

                    <h2 class="active">Registar</h2>

                </div>


                <!-- Erros -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div style="color:red; margin-bottom:20px; font-weight:600; text-align:center; background-color:#ffe6e6; padding:10px; border-radius:10px;">
                        @Html.ValidationSummary()
                    </div>
                }


                <form asp-controller="Account"
                      asp-action="Register"
                      method="post">


                    <!-- Nome -->
                    <div class="input-group">
                        <i class="fa-solid fa-user input-icon"></i>

                        <input asp-for="Name"
                               placeholder="Nome"
                               required />
                    </div>


                    <!-- Email -->
                    <div class="input-group">
                        <i class="fa-solid fa-envelope input-icon"></i>

                        <input asp-for="Email"
                               type="email"
                               placeholder="Email"
                               required />
                    </div>


                    <!-- Password -->
                    <div class="input-group">
                        <i class="fa-solid fa-key input-icon"></i>

                        <input asp-for="Password"
                               id="password-field"
                               type="password"
                               placeholder="Palavra-passe"
                               required />

                        <i class="fa-solid fa-eye password-toggle"
                           id="togglePassword"></i>
                    </div>


                    <!-- Confirmar -->
                    <div class="input-group">
                        <i class="fa-solid fa-key input-icon"></i>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               placeholder="Confirmar Palavra-passe"
                               required />
                    </div>


                    <div class="form-footer">

                        <div class="action-buttons">

                            <button type="submit" class="btn-login">
                                Registar
                            </button>

                        </div>

                    </div>

                </form>


            </div>
        </div>

    </div>

</body>
</html>


<script>

    const togglePassword = document.querySelector('#togglePassword');
    const password = document.querySelector('#password-field');

    togglePassword.addEventListener('click', function () {

        const type = password.getAttribute('type') === 'password'
            ? 'text'
            : 'password';

        password.setAttribute('type', type);

        this.classList.toggle('fa-eye');
        this.classList.toggle('fa-eye-slash');

    });

</script>
